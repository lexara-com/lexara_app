---
import Layout from '@/layouts/Layout.astro';
import HeaderLexara from '@/components/HeaderLexara.astro';
import Footer from '@/components/Footer.astro';
import CTA from '@/components/CTA.astro';

const features = [
  {
    icon: 'conflicts',
    title: 'Conflicts Checks on Every Intake',
    description: 'Engage checks every prospect against your firm\'s existing clients and matters. Possible conflicts are flagged for your review, and you decide whether the interview waits until you have cleared them.'
  },
  {
    icon: 'chart',
    title: 'Analytics & Reporting',
    description: 'Track conversation metrics, conversion rates, and client acquisition insights with detailed analytics.'
  },
  {
    icon: 'tag',
    title: 'White-Label Branding',
    description: 'Customize the interface with your firm\'s branding, colors, and messaging for a seamless client experience.'
  },
  {
    icon: 'shield',
    title: 'Privacy and Security Built In',
    description: 'Client data is encrypted in transit and at rest and is never used to train AI models. SOC 2 audit in progress; BAA available on request.'
  },
  {
    icon: 'mobile',
    title: 'Mobile Responsive',
    description: 'Prospects can complete intake on a phone, tablet, or computer.'
  },
  {
    icon: 'api',
    title: 'API & Integrations',
    description: 'Integrate with your existing practice management software, CRM, and other legal tech tools for a seamless workflow.'
  }
];
---

<Layout title="Features">
  <HeaderLexara />
  
  <main>
    <!-- Hero Section -->
    <section class="py-16 bg-gray-50">
      <div class="container mx-auto px-4 grid items-center gap-12 lg:grid-cols-[minmax(0,1fr)_420px]">
        <div>
          <h1 class="text-3xl md:text-[2.5rem] font-bold text-gray-900 mb-6">
            Everything Your Intake Needs.<br />Nothing It Doesn't.
          </h1>
          <p class="text-base text-gray-600 mb-8">
            <span class="font-semibold italic">Engage</span> runs a guided intake interview and your conflicts check, then gives your attorneys a summary to review. Your lawyers make every decision.
          </p>
          <div class="flex flex-wrap gap-4">
            <a 
              href={`${import.meta.env.PUBLIC_CONSOLE_URL}/signup?utm_source=engage&utm_campaign=features_hero`}
              class="inline-block px-7 py-3.5 bg-lexara-mahogany text-white text-base font-medium rounded-lg shadow-md transition-all duration-200 hover:scale-105 hover:shadow-xl"
            >
              Start Free Trial
            </a>
            <a 
              href="https://www.youtube.com/watch?v=H0zwv3Ppsyw"
              target="_blank"
              rel="noopener"
              class="inline-block px-7 py-3.5 bg-white text-gray-900 text-base font-medium rounded-lg border border-gray-300 shadow-md transition-all duration-200 hover:scale-105 hover:shadow-xl"
            >
              Watch the 1-Minute Demo
            </a>
          </div>
          
          <div class="flex flex-wrap items-center gap-6 mt-8 text-sm text-gray-600">
            <div class="flex items-center gap-2">
              <div class="w-2 h-2 bg-green-500 rounded-full"></div>
              <span>Customized to your practice areas</span>
            </div>
            <div class="flex items-center gap-2">
              <div class="w-2 h-2 bg-green-500 rounded-full"></div>
              <span>Responsive, Adaptable Agents</span>
            </div>
            <div class="flex items-center gap-2">
              <div class="w-2 h-2 bg-green-500 rounded-full"></div>
              <span>Fast setup</span>
            </div>
          </div>
        </div>
        
        <!-- Chat Preview -->
        <figure class="hidden lg:block m-0">
          <img
            src="https://static.lexara.app/images/engage-chat-sample-detail.png"
            alt="A sample Engage intake conversation about a car accident"
            class="w-full rounded-xl border border-gray-200 bg-white shadow-lg"
          />
        </figure>
      </div>
    </section>

    <!-- Everything You Need Section -->
    <section class="py-20 bg-white">
      <div class="container mx-auto px-4">
        <h2 class="text-3xl md:text-[2.5rem] font-bold text-center mb-5">Everything You Need for Client Intake</h2>
        <p class="text-center text-lg md:text-xl text-gray-600 mb-14 max-w-3xl mx-auto">
          Comprehensive features designed specifically for legal professionals
        </p>
        
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
          {features.map((feature) => (
            <div class="bg-gray-50 rounded-xl p-6 shadow-md transition-all duration-200 hover:scale-105 hover:shadow-xl">
              <div class="w-12 h-12 bg-lexara-dark-navy rounded-lg flex items-center justify-center mb-4">
                {feature.icon === 'conflicts' && (
                  <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-6 9l2 2 4-4" />
                  </svg>
                )}
                {feature.icon === 'chart' && (
                  <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z" />
                  </svg>
                )}
                {feature.icon === 'tag' && (
                  <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 7h.01M7 3h5c.512 0 1.024.195 1.414.586l7 7a2 2 0 010 2.828l-7 7a2 2 0 01-2.828 0l-7-7A1.994 1.994 0 013 12V7a4 4 0 014-4z" />
                  </svg>
                )}
                {feature.icon === 'shield' && (
                  <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
                  </svg>
                )}
                {feature.icon === 'mobile' && (
                  <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 18h.01M8 21h8a2 2 0 002-2V5a2 2 0 00-2-2H8a2 2 0 00-2 2v14a2 2 0 002 2z" />
                  </svg>
                )}
                {feature.icon === 'security' && (
                  <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />
                  </svg>
                )}
                {feature.icon === 'api' && (
                  <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4" />
                  </svg>
                )}
              </div>
              <h3 class="text-base font-semibold text-gray-900 mb-2">{feature.title}</h3>
              <p class="text-sm text-gray-600">{feature.description}</p>
            </div>
          ))}
        </div>
      </div>
    </section>



    <!-- CTA Section -->
    <CTA />
  </main>
  
  <Footer />
</Layout>