{
  "name": "lexara_app",
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "typecheck": "astro check",
    "lint": "eslint .",
    "test": "vitest run --config testing/vitest.config.ts",
    "test:watch": "vitest --config testing/vitest.config.ts",
    "test:coverage": "vitest run --config testing/vitest.config.ts --coverage",
    "deploy:dev": "cross-env CLOUDFLARE_ENV=dev npm run build && wrangler deploy",
    "deploy:test": "cross-env CLOUDFLARE_ENV=test npm run build && wrangler deploy",
    "deploy:production": "cross-env CLOUDFLARE_ENV=production npm run build && wrangler deploy"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.2.2",
    "@statsig/js-client": "^3.33.2",
    "astro": "^7.2.3"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.0.0",
    "@astrojs/check": "^0.9.4",
    "@eslint/js": "^9.39.1",
    "@tailwindcss/vite": "^4.3.0",
    "@types/node": "^24.10.1",
    "@typescript-eslint/parser": "^8.70.1",
    "@vitest/coverage-v8": "^4.0.16",
    "cross-env": "^10.1.0",
    "eslint": "^9.39.1",
    "eslint-plugin-astro": "^1.5.0",
    "tailwindcss": "^4.3.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.16",
    "wrangler": "^4.130.0"
  },
  "overrides": {
    "esbuild": "^0.28.1"
  }
}
