---
const steps = [
    {
        number: "01",
        icon: '<path d="M4 5h16a1 1 0 0 1 1 1v10a1 1 0 0 1-1 1h-9l-5 4v-4H4a1 1 0 0 1-1-1V6a1 1 0 0 1 1-1z"/><path d="M8 10h8M8 13h5"/>',
        header: "Prospects Reach Out at Their Convenience and Instantly Feel Heard",
        body: "A prospect opens your intake link and <span class='italic'>Engage</span> gathers the background info you need and conducts an interview. <span class='italic'>Engage</span> asks the questions you would ask."
    },
    {
        number: "02",
        icon: '<path d="M4 7h9M17 7h3M4 17h3M11 17h9"/><circle cx="15" cy="7" r="2"/><circle cx="9" cy="17" r="2"/>',
        header: "You Choose What Info to Collect and When the Conflict Check Runs",
        body: "Customize your intake. Run a conflicts check before interviewing the prospect, or run it at the same time as the interview. Customize conversations for different practice areas."
    },
    {
        number: "03",
        icon: '<path d="M9 6V5a2 2 0 0 1 2-2h2a2 2 0 0 1 2 2v1"/><rect x="3" y="6" width="18" height="14" rx="2"/><path d="M3 12h18"/><path d="M10 12v2h4v-2"/>',
        header: "Go Into Your Initial Client Meeting Knowing the Background",
        body: "The story, the timeline, the conflicts result — all ready when you are. Add a link and send an engagement letter with one click. Your client meets an attorney who already knows their case."
    },

]
---
<section class="bg-lexara-white-smoke px-6 py-14 text-lexara-dark-navy lg:py-20">
    <div class="mx-auto max-w-[1200px]">
        <p class="mb-8 text-sm lg:text-lg font-semibold uppercase tracking-[0.2em] text-lexara-light-navy">How Engage Works</p>
        <h2 class="font-serif font-normal leading-[1.15] text-[2rem] lg:text-[2.6rem]">For Less Than the Cost of One Billable Hour per Month, <br> You Get Smart Intake and Real-Time Conflicts Checks.</h2>
        <p class="font-serif italic leading-[1.15] text-[2rem] lg:text-[2.6rem]">And, You Get Your Time Back.</p>
        <ol role="list" class="mt-10 grid list-none grid-cols-1 gap-6 lg:mt-12 lg:grid-cols-3">
            {steps.map((step) => (
                <li class="rounded-[1.75rem] border border-[#E0DCD7] bg-white p-7 shadow-[0_1px_2px_rgba(30,43,59,.05),0_10px_28px_rgba(30,43,59,.06)] lg:p-8">
                    <div class="mb-5 flex items-center gap-4">
                        <span aria-hidden="true" class="grid h-14 w-14 shrink-0 place-items-center rounded-2xl bg-lexara-white-smoke text-lexara-mahogany">
                            <svg viewBox="0 0 24 24" width="28" height="28" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" set:html={step.icon} />
                        </span>
                        <span aria-hidden="true" class="font-serif text-3xl leading-none text-lexara-mahogany">{step.number}</span>
                    </div>
                    <h3 class="mb-3 font-serif text-2xl font-normal leading-[1.25]">{step.header}</h3>
                    <p class="text-lg leading-[1.55] text-lexara-light-navy" set:html={step.body} />
                </li>
            ))}
        </ol>
    </div>
</section>
