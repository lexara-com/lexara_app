---
const eyebrowClass = 'eyebrow text-sm font-semibold uppercase tracking-[0.2em] text-lexara-light-navy lg:text-lg';
const fieldClass = 'w-full min-w-0 rounded-[2rem] border-0 bg-white px-6 py-6 text-lg text-lexara-dark-navy placeholder:text-lexara-dark-navy focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-lexara-mahogany sm:px-8 sm:text-xl 2xl:py-8 2xl:text-3xl';
const contacts = [
    { title: 'Sales', description: "Questions about enterprise rates, pricing, or trials? We'll reply within one business day." },
    { title: 'Support', description: "Questions about integrations or related queries? Our techs will respond asap. " },
    { title: 'Bar and VLP Partnerships', description: 'We have specific solutions for Bar Associations and VLP organizations — ask us for more info!' },
];
---

<section id="contact" aria-labelledby="contact-heading" class="bg-lexara-white-smoke px-4 py-10 text-lexara-dark-navy sm:px-6 sm:py-14 lg:px-12 lg:py-16">
    <div class="mx-auto max-w-[1760px]">
        <p class:list={[eyebrowClass, 'mb-6']}>Contact</p>
        <h2 id="contact-heading" class="text-balance font-serif font-normal leading-tight text-[1.6875rem] sm:text-[2.025rem] lg:text-[2.7rem] 2xl:text-[4.05rem]">Tell Us About Your Intake... or Ask Us About Ours.</h2>
        <div class="grid grid-cols-1 items-start gap-12 lg:mt-6 lg:grid-cols-2 lg:items-stretch lg:gap-20">
            <div>
                <p class="mt-6 text-lg leading-relaxed text-lexara-light-navy sm:text-xl lg:mt-0 2xl:text-2xl">Whether you are a solo practitioner, or a firm with thousandos of lawyers, we can show you how <span class="italic">Engage</span> gives your firm verifiable ROI.</p>
                <div class="mt-6 lg:mt-8">
                    {contacts.map(({ title, description }) => (
                        <div class="border-t border-lexara-dark-navy/10 py-4 sm:py-5 lg:last:pb-0">
                            <h3 class:list={[eyebrowClass, 'font-sans']}>{title}</h3>
                            <p class="mt-2 text-lg leading-relaxed text-lexara-light-navy 2xl:text-2xl">{description}</p>
                        </div>
                    ))}
                </div>
            </div>

            <form data-contact-form action="mailto:sales@lexara.com" method="post" enctype="text/plain" aria-label="Contact Lexara" aria-describedby="contact-form-note" class="min-w-0 space-y-6 sm:space-y-8 lg:grid lg:grid-rows-[auto_auto_minmax(8rem,1fr)_auto_auto] lg:gap-8 lg:space-y-0">
                <div class="grid grid-cols-1 gap-6 sm:grid-cols-2 sm:gap-8">
                    <div>
                        <label for="contact-first-name" class="sr-only">First Name</label>
                        <input id="contact-first-name" name="firstName" type="text" autocomplete="given-name" placeholder="First Name" required class={fieldClass} />
                    </div>
                    <div>
                        <label for="contact-last-name" class="sr-only">Last Name</label>
                        <input id="contact-last-name" name="lastName" type="text" autocomplete="family-name" placeholder="Last Name" required class={fieldClass} />
                    </div>
                </div>
                <div>
                    <label for="contact-email" class="sr-only">Email</label>
                    <input id="contact-email" name="email" type="email" autocomplete="email" placeholder="Email" required class={fieldClass} />
                </div>
                <div class="lg:min-h-0">
                    <label for="contact-message" class="sr-only">Send Message</label>
                    <textarea id="contact-message" name="message" rows="5" placeholder="Send Message" required class:list={[fieldClass, 'block resize-y lg:h-full lg:min-h-0']} />
                </div>
                <button type="submit" class="w-full rounded-[2rem] bg-lexara-mahogany px-8 py-6 text-xl font-semibold text-white transition-colors hover:bg-lexara-mahogany/90 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-lexara-mahogany 2xl:py-8 2xl:text-3xl">Submit</button>
                <p id="contact-form-note" class="text-sm leading-relaxed text-lexara-light-navy">Submit opens your email app with a draft addressed to sales@lexara.com.</p>
            </form>
        </div>
    </div>
</section>

<script>
    function initializeContactForms() {
        document.querySelectorAll<HTMLFormElement>('[data-contact-form]').forEach((form) => {
            if (form.dataset.initialized) return;
            form.addEventListener('submit', (event) => {
                event.preventDefault();
                const data = new FormData(form);
                const name = `${String(data.get('firstName') ?? '').trim()} ${String(data.get('lastName') ?? '').trim()}`;
                const body = `Name: ${name}\nEmail: ${data.get('email')}\n\n${data.get('message')}`;
                window.location.href = `mailto:sales@lexara.com?subject=${encodeURIComponent('Engage intake inquiry')}&body=${encodeURIComponent(body)}`;
            });
            form.dataset.initialized = 'true';
        });
    }
    initializeContactForms();
    document.addEventListener('astro:page-load', initializeContactForms);
</script>
