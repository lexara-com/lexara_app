---
// Real client testimonials only. Add entries to public/data/testimonials.json
// (with written permission from the person quoted).
import testimonialsData from '../../public/data/testimonials.json';

interface Testimonial {
  id: number;
  text: string;
  author: string;
  role?: string;
  company?: string;
  photo?: string;
}

const testimonials: Testimonial[] = testimonialsData.testimonials;
---

{testimonials.length > 0 && (
  <section class="bg-lexara-white-smoke px-4 py-10 lg:py-14" aria-labelledby="testimonials-title">
    <div class="mx-auto max-w-sm">
      <p class="text-center text-sm font-semibold uppercase tracking-[0.2em] text-lexara-light-navy">What lawyers are saying</p>
      <h2 id="testimonials-title" class="sr-only">Testimonials</h2>
      <div class="mt-6 grid gap-6">
        {testimonials.map((t) => (
          <figure class="rounded-xl bg-white p-4 shadow-[0_1px_2px_rgba(30,43,59,.06),0_12px_32px_rgba(30,43,59,.08)]">
            <svg class="h-4 w-4 text-lexara-mahogany" viewBox="0 0 40 40" fill="currentColor" aria-hidden="true">
              <path d="M16 10c-6 2-10 7-10 14v6h11V19H11c0-4 2-6 6-7zm17 0c-6 2-10 7-10 14v6h11V19h-6c0-4 2-6 6-7z" />
            </svg>
            <blockquote class="mt-2 font-serif text-[12px] leading-relaxed text-lexara-dark-navy">
              {t.text}
            </blockquote>
            <figcaption class="mt-3 flex items-center gap-2">
              {t.photo && (
                <img
                  src={t.photo}
                  alt={t.author}
                  width="32"
                  height="32"
                  loading="lazy"
                  decoding="async"
                  class="h-8 w-8 shrink-0 rounded-full object-cover ring-1 ring-lexara-white-smoke"
                />
              )}
              <div>
                <p class="text-[12px] font-semibold text-lexara-dark-navy">{t.author}</p>
                {(t.role || t.company) && (
                  <p class="text-[11px] text-lexara-light-navy">{[t.role, t.company].filter(Boolean).join(', ')}</p>
                )}
              </div>
            </figcaption>
          </figure>
        ))}
      </div>
    </div>
  </section>
)}
