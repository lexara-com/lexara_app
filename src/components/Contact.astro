---
const eyebrowClass = 'eyebrow text-sm font-semibold uppercase tracking-[0.2em] text-lexara-light-navy lg:text-base';
const fieldClass = 'w-full min-w-0 min-h-[56px] rounded-[18px] border border-lexara-light-navy/35 bg-white px-4 py-3.5 text-base text-lexara-dark-navy placeholder:text-lexara-light-navy focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-lexara-mahogany';
const contacts = [
    { title: 'Sales', description: "Questions about enterprise rates, pricing, or trials? We'll reply within one business day." },
    { title: 'Support', description: "Need help with your account or setup? We reply within one business day." },
    { title: 'Bar and VLP Partnerships', description: 'We have specific solutions for Bar Associations and VLP organizations — ask us for more info!' },
];
---

<section id="contact" aria-labelledby="contact-heading" class="bg-lexara-white-smoke px-6 py-14 text-lexara-dark-navy lg:py-20">
    <div class="mx-auto max-w-[1200px]">
        <p class:list={[eyebrowClass, 'mb-6']}>Contact</p>
        <h2 id="contact-heading" class="text-balance font-serif font-normal leading-tight text-[1.75rem] lg:text-4xl">Tell Us About Your Intake... or Ask Us About Ours.</h2>
        <div class="grid grid-cols-1 items-start gap-12 lg:mt-6 lg:grid-cols-[minmax(0,1fr)_minmax(0,1.3fr)] lg:items-start lg:gap-16">
            <div>
                <p class="mt-6 text-base leading-relaxed text-lexara-light-navy sm:text-lg lg:mt-0">Lexara <span class="italic">Engage</span> has a provable ROI. Whether you’re a solo practitioner or at a large firm, we will show you how much administrative time Lexara <span class="italic">Engage</span> can save you.</p>
                <div class="mt-6 lg:mt-8">
                    {contacts.map(({ title, description }) => (
                        <div class="border-t border-lexara-dark-navy/10 py-4 sm:py-5 lg:last:pb-0">
                            <h3 class:list={[eyebrowClass, 'font-sans']}>{title}</h3>
                            <p class="mt-2 text-base leading-relaxed text-lexara-light-navy">{description}</p>
                        </div>
                    ))}
                </div>
            </div>

            <form data-contact-form action="mailto:support@lexara.com" method="post" enctype="text/plain" aria-label="Contact Lexara" aria-describedby="contact-form-note" class="min-w-0 grid gap-5">
                <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
                    <div>
                        <label for="contact-first-name" class="sr-only">First Name</label>
                        <input id="contact-first-name" name="firstName" type="text" autocomplete="given-name" placeholder="First Name" required class={fieldClass} />
                    </div>
                    <div>
                        <label for="contact-last-name" class="sr-only">Last Name</label>
                        <input id="contact-last-name" name="lastName" type="text" autocomplete="family-name" placeholder="Last Name" required class={fieldClass} />
                    </div>
                </div>
                <div>
                    <label for="contact-email" class="sr-only">Email</label>
                    <input id="contact-email" name="email" type="email" autocomplete="email" placeholder="Email" required class={fieldClass} />
                </div>
                <div>
                    <label for="contact-message" class="sr-only">Send Message</label>
                    <textarea id="contact-message" name="message" rows="4" placeholder="Message" required class:list={[fieldClass, 'block resize-y']} />
                </div>
                <button type="submit" class="justify-self-start min-h-[48px] rounded-full bg-lexara-mahogany px-7 py-3 text-base font-semibold text-white shadow-md hover:bg-lexara-mahogany/90 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-lexara-mahogany">Submit</button>
                <p id="contact-form-note" class="text-sm leading-relaxed text-lexara-light-navy">Submit opens your email app with a draft addressed to support@lexara.com.</p>
            </form>
        </div>
    </div>
</section>

<script>
    function initializeContactForms() {
        document.querySelectorAll<HTMLFormElement>('[data-contact-form]').forEach((form) => {
            if (form.dataset.initialized) return;
            form.addEventListener('submit', (event) => {
                event.preventDefault();
                const data = new FormData(form);
                const name = `${String(data.get('firstName') ?? '').trim()} ${String(data.get('lastName') ?? '').trim()}`;
                const body = `Name: ${name}\nEmail: ${data.get('email')}\n\n${data.get('message')}`;
                window.location.href = `mailto:support@lexara.com?subject=${encodeURIComponent('Engage intake inquiry')}&body=${encodeURIComponent(body)}`;
            });
            form.dataset.initialized = 'true';
        });
    }
    initializeContactForms();
    document.addEventListener('astro:page-load', initializeContactForms);
</script>
