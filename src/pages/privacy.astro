---
import Layout from '@/layouts/Layout.astro';
import HeaderLexara from '@/components/HeaderLexara.astro';
import Footer from '@/components/Footer.astro';
import Container from '@/components/ui/Container.astro';
import Section from '@/components/ui/Section.astro';

const lastUpdated = 'November 2, 2026';
---

<Layout title="Privacy Policy">
  <HeaderLexara />
  
  <main>
    <Section background="white" padding="xlarge">
      <Container size="medium">
        <div class="prose prose-lg max-w-none">
          <h1 class="text-3xl font-semibold text-lexara-dark-navy mb-4">Privacy Policy</h1>
          <p class="text-gray-600 mb-8">Last updated: {lastUpdated}</p>
          
          <div class="bg-lexara-white-smoke rounded-2xl p-8 mb-8">
            <p class="text-gray-700 mb-0">
              This Privacy Policy explains how Lexara Consulting LLC d/b/a Lexara ("Lexara," "we," or "us") collects, uses, and protects information when law firms use Lexara Engage, our AI-guided client intake and conflicts-checking platform, and when people visit lexara.app.
            </p>
          </div>

          <h2 class="text-xl font-semibold text-lexara-dark-navy mt-12 mb-4">Information We Collect</h2>
          <p class="text-gray-700 mb-4">
            We collect information you provide directly to us, such as when you create an account, use our services, or contact us for support. This may include:
          </p>
          <ul class="list-disc pl-6 mb-8 text-gray-700">
            <li>Account information (name, email, firm name)</li>
            <li>Usage data and analytics</li>
            <li>Billing and payment information</li>
            <li>Information your firm's prospective clients submit through your Engage intake, such as their contact details, a description of their matter, and the names needed for your conflicts check</li>
          </ul>

          <h2 class="text-xl font-semibold text-lexara-dark-navy mt-12 mb-4">Prospective Clients' Intake Information</h2>
          <p class="text-gray-700 mb-8">
            Your firm controls the information its prospective clients submit through Engage. Lexara processes that information on your firm's behalf, only to run the intake, conflicts check, and interview your firm sets up, and to support your firm's use of the service. A prospective client with questions about their information should contact the firm they reached out to.
          </p>
          
          <h2 class="text-xl font-semibold text-lexara-dark-navy mt-12 mb-4">How We Use Your Information</h2>
          <p class="text-gray-700 mb-4">
            We use the information we collect to:
          </p>
          <ul class="list-disc pl-6 mb-8 text-gray-700">
            <li>Provide, maintain, and improve our services</li>
            <li>Process transactions and send related information</li>
            <li>Send technical notices and support messages</li>
            <li>Respond to your comments and questions</li>
            <li>Monitor and analyze trends and usage</li>
          </ul>
          <p class="text-gray-700 mb-8">
            We do not sell personal information, we do not share it for targeted advertising, and we never use your data or your clients' data to train AI models.
          </p>

          <h2 class="text-xl font-semibold text-lexara-dark-navy mt-12 mb-4">Data Security</h2>
          <p class="text-gray-700 mb-8">
            Client data is encrypted in transit and at rest, and access is limited to the people who need it to provide the service. Our SOC 2 audit is in progress, with the report expected in February 2027. A Business Associate Agreement (BAA) is available on request.
          </p>
          
          <h2 class="text-xl font-semibold text-lexara-dark-navy mt-12 mb-4">Your Rights</h2>
          <p class="text-gray-700 mb-4">
            You have the right to:
          </p>
          <ul class="list-disc pl-6 mb-8 text-gray-700">
            <li>Access your personal information</li>
            <li>Correct inaccurate data</li>
            <li>Request deletion of your data</li>
            <li>Export your data in a portable format</li>
            <li>Opt-out of marketing communications</li>
          </ul>
          
          <h2 class="text-xl font-semibold text-lexara-dark-navy mt-12 mb-4">Contact Us</h2>
          <p class="text-gray-700 mb-8">
            If you have questions about this Privacy Policy or our privacy practices, please contact us at:
          </p>
          <div class="bg-lexara-white-smoke rounded-lg p-6">
            <p class="text-gray-700 mb-2">
              <strong>Email:</strong> support@lexara.com
            </p>
            <p class="text-gray-700 mb-2">
              <strong>Address:</strong> Lexara Consulting LLC<br />
              500 W. Hickman #318<br />
              Waukee, IA 50263
            </p>
          </div>
        </div>
      </Container>
    </Section>
  </main>
  
  <Footer />
</Layout>