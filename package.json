{
  "name": "lexara_app",
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "typecheck": "astro check",
    "lint": "eslint .",
    "test": "vitest run --config testing/vitest.config.ts",
    "test:watch": "vitest --config testing/vitest.config.ts",
    "test:coverage": "vitest run --config testing/vitest.config.ts --coverage",
    "deploy:dev": "npm run build && wrangler deploy --env dev",
    "deploy:test": "npm run build && wrangler deploy",
    "deploy:production": "npm run build && wrangler deploy --env production"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^13.7.0",
    "@statsig/js-client": "^3.33.2",
    "astro": "^6.4.5"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.4",
    "@eslint/js": "^9.39.1",
    "@tailwindcss/vite": "^4.3.0",
    "@types/node": "^24.10.1",
    "@typescript-eslint/parser": "^8.70.1",
    "@vitest/coverage-v8": "^4.0.16",
    "eslint": "^9.39.1",
    "eslint-plugin-astro": "^1.5.0",
    "tailwindcss": "^4.3.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.16",
    "wrangler": "^4.54.0"
  },
  "overrides": {
    "vite": "^7",
    "esbuild": "^0.28.1"
  }
}
