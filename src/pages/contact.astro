---
import Layout from '@/layouts/Layout.astro';
import HeaderLexara from '@/components/HeaderLexara.astro';
import Footer from '@/components/Footer.astro';
import Button from '@/components/ui/Button.astro';
import Container from '@/components/ui/Container.astro';
import Section from '@/components/ui/Section.astro';
import { messageFor } from '@/lib/contact';

const formMessage = messageFor(Astro.url.searchParams.get('contact'));
const renderedAt = Date.now();
---

<Layout title="Contact">
  <HeaderLexara />
  
  <main>
    <Section background="smoke" padding="xlarge">
      <Container size="medium">
        <div class="text-center">
          <h1 class="text-3xl md:text-[2.5rem] font-semibold text-lexara-dark-navy mb-6">
            Get in Touch
          </h1>
          <p class="text-lg text-gray-600 max-w-2xl mx-auto">
            Have questions about Lexara <em>Engage</em>? We’ll show you how it handles intake and conflict checks for your firm.
          </p>
        </div>
      </Container>
    </Section>
    
    <Section background="white" padding="xlarge">
      <Container size="large">
        <div class="grid grid-cols-1 md:grid-cols-2 gap-12">
          <div>
            <h2 class="text-xl font-semibold text-lexara-dark-navy mb-6">Let's Start a Conversation</h2>
            <p class="text-gray-600 mb-8">
              Whether you're ready to get started or just have questions, our team is here to help.
            </p>
            
            <div class="space-y-6">
              <div>
                <h3 class="font-semibold text-lexara-dark-navy mb-2">Sales and Support</h3>
                <p class="text-gray-600"><a href="mailto:support@lexara.com" class="underline">support@lexara.com</a></p>
                <p class="text-gray-600">515-850-7226</p>
              </div>
              
              <div>
                <h3 class="font-semibold text-lexara-dark-navy mb-2">Office</h3>
                <p class="text-gray-600">
                  Lexara Consulting LLC<br />
                  500 W. Hickman #318<br />
                  Waukee, IA 50263
                </p>
              </div>
            </div>
          </div>
          
          <div class="bg-white rounded-2xl shadow-lg p-8">
            <form id="contact-form" action="/api/contact" method="post" class="space-y-6">
              <input type="hidden" name="return" value="/contact" />
              <input type="hidden" name="cf_ts" value={renderedAt} />
              <p class="absolute -left-[100vw] h-px w-px overflow-hidden" aria-hidden="true"><label>Leave this field empty <input type="text" name="cf_hp" tabindex="-1" autocomplete="off" /></label></p>
              {formMessage && (
                <p role={formMessage.ok ? 'status' : 'alert'} class:list={['rounded-lg px-4 py-3 text-sm', formMessage.ok ? 'bg-lexara-white-smoke text-lexara-dark-navy' : 'bg-lexara-mahogany/15 text-lexara-dark-navy']}>{formMessage.text}</p>
              )}
              <div>
                <label for="contact-name" class="block text-sm font-medium text-gray-700 mb-2">Name</label>
                <input id="contact-name" name="name" type="text" autocomplete="name" required class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-lexara-mahogany focus:border-transparent" />
              </div>
              
              <div>
                <label for="contact-email" class="block text-sm font-medium text-gray-700 mb-2">Email</label>
                <input id="contact-email" name="email" type="email" autocomplete="email" required class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-lexara-mahogany focus:border-transparent" />
              </div>
              
              <div>
                <label for="contact-firm" class="block text-sm font-medium text-gray-700 mb-2">Law Firm</label>
                <input id="contact-firm" name="firm" type="text" autocomplete="organization" class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-lexara-mahogany focus:border-transparent" />
              </div>
              
              <div>
                <label for="contact-message" class="block text-sm font-medium text-gray-700 mb-2">Message</label>
                <textarea id="contact-message" name="message" rows="4" required class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-lexara-mahogany focus:border-transparent"></textarea>
              </div>
              
              <Button 
                type="submit"
                variant="primary"
                size="large"
                class="w-full"
              >
                Send Message
              </Button>
            </form>
          </div>
        </div>
      </Container>
    </Section>
  </main>
  
  <Footer />
</Layout>