---
// Real client testimonials only. Add entries to public/data/testimonials.json
// (with written permission from the person quoted).
import testimonialsData from '../../public/data/testimonials.json';

interface Testimonial {
  id: number;
  text: string;
  author: string;
  role?: string;
  company?: string;
  photo?: string;
}

const testimonials: Testimonial[] = testimonialsData.testimonials;
---

{testimonials.length > 0 && (
  <section class="bg-lexara-white-smoke px-4 py-16 lg:py-24" aria-labelledby="testimonials-title">
    <div class="mx-auto max-w-5xl">
      <p class="text-center text-sm lg:text-lg font-semibold uppercase tracking-[0.2em] text-lexara-light-navy">What lawyers are saying</p>
      <h2 id="testimonials-title" class="sr-only">Testimonials</h2>
      <div class="mt-10 grid gap-8">
        {testimonials.map((t) => (
          <figure class="rounded-3xl bg-white p-8 shadow-[0_1px_2px_rgba(30,43,59,.06),0_12px_32px_rgba(30,43,59,.08)] sm:p-12">
            <svg class="h-10 w-10 text-lexara-mahogany" viewBox="0 0 40 40" fill="currentColor" aria-hidden="true">
              <path d="M16 10c-6 2-10 7-10 14v6h11V19H11c0-4 2-6 6-7zm17 0c-6 2-10 7-10 14v6h11V19h-6c0-4 2-6 6-7z" />
            </svg>
            <blockquote class="mt-6 font-serif text-xl leading-relaxed text-lexara-dark-navy sm:text-2xl lg:text-[1.75rem] lg:leading-[1.5]">
              {t.text}
            </blockquote>
            <figcaption class="mt-8 flex items-center gap-5">
              {t.photo && (
                <img
                  src={t.photo}
                  alt={t.author}
                  width="80"
                  height="80"
                  loading="lazy"
                  decoding="async"
                  class="h-20 w-20 shrink-0 rounded-full object-cover ring-4 ring-lexara-white-smoke"
                />
              )}
              <div>
                <p class="text-lg font-semibold text-lexara-dark-navy">{t.author}</p>
                {(t.role || t.company) && (
                  <p class="text-base text-lexara-light-navy">{[t.role, t.company].filter(Boolean).join(', ')}</p>
                )}
              </div>
            </figcaption>
          </figure>
        ))}
      </div>
    </div>
  </section>
)}
