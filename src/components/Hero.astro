---
import { checkGate } from '@/lib/statsig-server';
import { getConsoleUrl } from '../lib/env';
import Button from './ui/Button.astro';

const showEmailCapture = await checkGate('show-email-capture-form', Astro);
const consoleUrl = getConsoleUrl(Astro.locals);
---

<section class="bg-lexara-white-smoke px-6 py-16 lg:py-24">
  <div class="mx-auto max-w-[1200px]">
    <div class="grid grid-cols-1 items-center gap-12 lg:grid-cols-[1.05fr_1fr]">
      <div class="text-left">
        <h1 class="mb-6 font-serif text-4xl font-normal leading-[1.1] text-lexara-dark-navy sm:text-[2.5rem] lg:text-[2.875rem]">
          Whenever Your Prospect Reaches Out, <span class="italic">Engage</span> Is Ready
        </h1>
        <p class="mb-8 text-base leading-relaxed text-lexara-light-navy lg:text-lg">
          Whether it's 9 AM or 9 PM, <span class="italic">Engage</span> is ready to conduct a high-quality intake interview and conflicts check. Your prospect is qualified, the conflicts check is in hand, and you walk into your first client meeting ready to work instead of gathering background information.
        </p>
      
        {showEmailCapture ? (
        <form class="max-w-md mx-auto mb-4" data-signup-form>
          <div class="flex gap-3">
            <input
              type="email"
              placeholder="Enter your work email"
              class="flex-1 px-4 py-3 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-gray-900 focus:border-transparent"
              required
            />
            <button
              type="submit"
              class="px-6 py-3 bg-gray-900 text-white font-medium rounded-lg hover:bg-gray-800 transition-colors whitespace-nowrap"
            >
              Start 30-day Free Trial
            </button>
          </div>
        </form>
        ) : (
        <div class="flex flex-col sm:flex-row gap-4 justify-left mb-4">
          <Button
            href={`${consoleUrl}/signup?plan=starter&utm_source=engage&utm_campaign=hero`}
            variant="primary"
          >
            Start Free Trial
          </Button>
          <Button
            href="https://www.youtube.com/watch?v=H0zwv3Ppsyw"
            variant="outline"
            class="!rounded-lg border-lexara-mahogany text-lexara-mahogany hover:!bg-lexara-mahogany hover:!text-white"
          >
            Watch Demo
          </Button>
        </div>
        )}
        
        
        <div class="flex flex-wrap items-center gap-6 text-base text-lexara-light-navy">
          <div class="flex items-center gap-2">
            <div class="w-2 h-2 bg-lexara-mahogany rounded-full"></div>
            <span>30 days free</span>
          </div>
          <div class="flex items-center gap-2">
            <div class="w-2 h-2 bg-lexara-mahogany rounded-full"></div>
            <span>We help you set up</span>
          </div>
          <div class="flex items-center gap-2">
            <div class="w-2 h-2 bg-lexara-mahogany rounded-full"></div>
            <span>Cancel anytime</span>
          </div>
        </div>
      </div>
      
      <div class="hidden lg:block">
        <div class="bg-white rounded-xl shadow-2xl overflow-hidden" style="height: 560px;">
          <iframe
            src="https://engage.lexara.app/demo"
            class="w-full h-full border-0"
            title="Engage Demo"
            allow="microphone"
          ></iframe>
        </div>
      </div>
    </div>
  </div>
</section>

<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    const form = document.querySelector('[data-signup-form]');
    
    form?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const email = e.target.querySelector('input[type="email"]');
      
      if (email?.value) {
        // Track conversion
        if (window.logConversion) {
          window.logConversion('email_capture', 1, {
            email: email.value,
            source: 'hero'
          });
        }
        
        // Redirect to console signup with email
        const signupUrl = new URL(window.__ENV__.PUBLIC_CONSOLE_URL + '/signup');
        signupUrl.searchParams.set('email', email.value);
        signupUrl.searchParams.set('utm_source', 'engage');
        signupUrl.searchParams.set('utm_campaign', 'hero_email');
        window.location.href = signupUrl.toString();
      }
    });
    
    // Track CTA clicks
    document.querySelectorAll('a[href*="signup"]').forEach(link => {
      link.addEventListener('click', () => {
        if (window.logClick) {
          window.logClick('hero_cta', {
            href: link.getAttribute('href'),
            text: link.textContent?.trim()
          });
        }
      });
    });
  });
</script>